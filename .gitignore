# ==================================================
# LAR - Git ignore
# ==================================================

# --------------------------------------------------
# PERSISTENT DATA AND LOCAL CONFIGURATION
# --------------------------------------------------

# Version the data folders and exclude their contents.
# .gitkeep files keep the structure in Git.
/data/**
!/data/**/
!/data/**/.gitkeep

# --------------------------------------------------
# ENVIRONMENT VARIABLES AND SECRETS
# --------------------------------------------------

# Ignore environment variables with local configuration
# or credentials.
.env
.env.*
**/.env
**/.env.*

# Allow example templates without secrets.
!.env.example
!**/.env.example

# --------------------------------------------------
# CERTIFICATES AND PRIVATE KEYS
# --------------------------------------------------

# Ignore local certificates and private keys.
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.csr
*.der

# --------------------------------------------------
# LOGS
# --------------------------------------------------

# Ignore logs generated by services and scripts.
*.log
/logs/

# --------------------------------------------------
# BACKUPS AND DUMPS
# --------------------------------------------------

# Ignore backups and database dumps.
*.sql
*.sql.gz
*.dump
*.dump.gz
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip

# --------------------------------------------------
# TEMPORARY FILES
# --------------------------------------------------

# Ignore temporary and recovery files.
*.tmp
*.temp
*.swp
*.swo
*~

# Operating system files.
.DS_Store
Thumbs.db

# --------------------------------------------------
# EDITORS AND IDEs
# --------------------------------------------------

# Personal editor configuration.
.idea/
.vscode/
*.code-workspace

# --------------------------------------------------
# LOCAL DOCKER COMPOSE
# --------------------------------------------------

# Ignore local configs that override
# the shared Docker Compose configuration.
docker-compose.override.yml
docker-compose.local.yml

# --------------------------------------------------
# Common folders
# --------------------------------------------------
.cursor/
sites/
