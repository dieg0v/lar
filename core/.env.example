# Local variable template.
# ./lar.sh init writes data/.env and does not overwrite it when it already has content.
# Locally the MySQL and MariaDB root user uses the password toor.
# No database is created.
# MinIO uses minioadmin / minioadmin. The password must be 8 characters or more.

MYSQL57_ROOT_PASSWORD=toor
MYSQL8_ROOT_PASSWORD=toor
MARIADB1011_ROOT_PASSWORD=toor
MARIADB101_ROOT_PASSWORD=toor
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
