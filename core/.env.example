# Plantilla de variables locales.
# ./lar.sh init escribe data/.env y no lo sobrescribe si ya tiene contenido.
# En local el usuario root de MySQL y MariaDB usa la contraseña toor.
# No se crea ninguna base de datos.
# MinIO usa minioadmin / minioadmin. La contraseña tiene que tener 8 caracteres o más.

MYSQL57_ROOT_PASSWORD=toor
MYSQL8_ROOT_PASSWORD=toor
MARIADB1011_ROOT_PASSWORD=toor
MARIADB101_ROOT_PASSWORD=toor
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
