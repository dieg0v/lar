export LANG="${LANG:-C.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-C.UTF-8}"
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="lar"
DISABLE_AUTO_UPDATE=true
DISABLE_UPDATE_PROMPT=true
# zsh-syntax-highlighting tiene que ir el último.
plugins=(
  git
  artisan
  zsh-autosuggestions
  zsh-syntax-highlighting
)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=110'

# nvm antes de oh-my-zsh para que los plugins del final conserven el editor de línea.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
  if [[ -n "${LAR_NODE_VERSION:-}" ]]; then
    nvm use --silent "$LAR_NODE_VERSION" || print -u2 "No está Node ${LAR_NODE_VERSION}. Ejecuta nvm ls"
  fi
fi

source "$ZSH/oh-my-zsh.sh"

# Cada shell tiene su propio php. Otra terminal no lo cambia.
LAR_PHP_BIN_DIR="/tmp/lar-php-$$"
mkdir -p "$LAR_PHP_BIN_DIR"
chmod 700 "$LAR_PHP_BIN_DIR"
export PATH="${LAR_PHP_BIN_DIR}:${PATH}"
rm -f "$HOME/bin/php"

lar_php_use() {
  local version="$1"
  if [[ -z "$version" || ! -x "/usr/bin/php${version}" ]]; then
    print -u2 "No está PHP ${version}."
    print -u2 -n "Versiones:"
    local bin
    for bin in /usr/bin/php<->.*; do
      [[ -x "$bin" ]] || continue
      print -u2 -n " ${bin:t:s/php/}"
    done
    print -u2
    return 1
  fi
  ln -sfn "/usr/bin/php${version}" "${LAR_PHP_BIN_DIR}/php"
  export LAR_PHP_VERSION="$version"
  rehash
}

phpuse() {
  if [[ -z "$1" ]]; then
    print "Uso: phpuse 8.5"
    print "php5 deja 5.6, php7 deja 7.4 y php8 deja 8.5. Solo en esta terminal."
    return 1
  fi
  lar_php_use "$1"
}

php5() {
  lar_php_use 5.6 || return 1
  [[ $# -eq 0 ]] || php "$@"
}

php7() {
  lar_php_use 7.4 || return 1
  [[ $# -eq 0 ]] || php "$@"
}

php8() {
  lar_php_use 8.5 || return 1
  [[ $# -eq 0 ]] || php "$@"
}

if [[ -n "${LAR_PHP_VERSION:-}" ]]; then
  lar_php_use "$LAR_PHP_VERSION" >/dev/null
fi

lar_prompt_node() {
  local version
  version=$(node -v 2>/dev/null) || return 0
  print -n " node${version#v}"
}

if [[ -n "${LAR_SHELL_CHECK:-}" ]]; then
  unset LAR_SHELL_CHECK
  node -v && npm -v && php -v
fi

# Los sitios están montados desde el Mac: git los ve de otro usuario.
if ! command git config --global --get-all safe.directory 2>/dev/null | grep -qx '\*'; then
  command git config --global --add safe.directory '*'
fi

trap 'rm -rf "$LAR_PHP_BIN_DIR"' EXIT
